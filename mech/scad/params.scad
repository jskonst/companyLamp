// companyLamp — корпус под плафон VL0079 (E14, белый пластик, усечённый конус,
// узкое отверстие сверху, открытое дно). Все размеры в мм.
// [EST] = оценка, уточнить штангенциркулем.
// Размеры из эскиза пользователя (config.scad): diameter=86, inner_d=72,
// lamp_lower_d=101, cap_thikness=5, lamp_thikness=2, height=15, border=5, depth=10.

$fn = 96;

// ---- Плафон VL0079 ----
SHADE_LOWER_D   = 101;   // нижний (открытый) край, наружный  [EST, эскиз]
SHADE_WALL      = 2;     // толщина стенки                     [EST, эскиз]
SHADE_TOP_D     = 62;    // верх снаружи                       [EST, фото]
SHADE_TOP_HOLE  = 29;    // отверстие под E14                  [EST]
SHADE_H         = 125;   // высота                             [EST, фото]
SHADE_SEAT      = 10;    // насколько край заходит на юбку (depth из эскиза)

// ---- Защёлки (вместо трапецеидальной резьбы) ----
N_SNAPS      = 6;     // число радиальных защёлок 4..6
SNAP_W       = 8;     // ширина лапки
SNAP_T       = 1.6;   // толщина лапки (PETG 1.6, PLA 1.8)
SNAP_L       = 12;    // свободная длина лапки над прорезью
SNAP_HOOK    = 1.2;   // вылет зуба внутрь (на край плафона)
SNAP_GAP     = 0.6;   // прорезь вокруг лапки
FIT          = 0.3;   // зазор посадки плафона на юбку

// ---- Корпус ----
WALL         = 2.4;
BAY_H        = 40;    // высота отсека электроники (35..45)
SKIRT_H      = SHADE_SEAT + 2;
BASE_BOT_D   = 118;   // низ основания (лёгкий конус к плафону)
FLOOR        = 2.4;

// ---- LED-кольцо (ring.scad эскиза) ----
LED_RING_OD  = 86;    // diameter
LED_RING_ID  = 72;    // inner_d
LED_N        = 24;
LED_PCB_T    = 1.6;

// ---- E14 декор + кабельный ввод ----
E14_OD       = 28;    // имитация патрона E14  [EST]
E14_H        = 22;
CABLE_D      = 5;     // проход провода ленты

// ---- Электроника ----
LOLIN        = [34.2, 25.6, 1.2];  // Wemos D1 mini v3/v4   [EST rev]
LOLIN_HOLES  = [28, 18];           // M2 / саморез
STANDOFF_H   = 10;
POWER_PCB    = [50, 35, 1.6];      // TP4056 + boost 5V 2A  [EST]
USBC         = [9.5, 3.6];         // окно USB-C в задней стенке
WITH_BATTERY = true;
BATT_BAY     = [22, 70, 20];       // 18650 в держателе      [EST]

// ---- Кнопка / индикатор ----
BTN_D        = 7;     // тактовая 6x6 с толкателем
PIPE_D       = 4;     // световод к leds[0]
VENT_SLOTS   = 7;

// ---- Производные ----
SKIRT_OD = SHADE_LOWER_D - 2*SHADE_WALL - FIT;   // юбка внутри края плафона
BODY_TOP_D = SHADE_LOWER_D + 2*WALL;             // наружный уступ под краем
